{
  "name": "all-in-macau",
  "version": "3.0.0",
  "private": true,
  "description": "2026 DT Outing - ALL IN MACAU (소수의 선택 + 룰렛 테이블 대항전). 로그인 없는 공개 실시간 서버",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node18 --packages=external --outfile=dist/server.cjs --format=cjs --log-level=warning",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.cjs",
    "loadtest": "node scripts/loadtest.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "typescript": "5.9",
    "vite": "^6.4.6"
  }
}
